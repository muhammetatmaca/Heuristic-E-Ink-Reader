{
  "expo": {
    "name": "Heuristic E-Ink Reader",
    "slug": "heuristic-eink-reader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#EFE6D2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.virelon.eink"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#20260C"
      },
      "package": "com.virelon.eink"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-asset"
    ]
  }
}
